# ==========================================
# 이 파일을 복사해서 "deploy.env" 라는 이름으로 저장하고,
# 실제 값들을 채워 넣기
#
# 
#
# 사용법:
#   cp deploy.env.example deploy.env
#   (deploy.env 열어서 아래 값들 채우기)
#   ./scripts/deploy_cloudrun.sh
# ==========================================

PROJECT_ID=your-gcp-project-id
REGION=asia-northeast3
SERVICE_NAME=wheretogo-backend

# Hugging Face Hub repo id
KLUE_MODEL_PATH=your-hf-id/wheretogo-klue-roberta
KLUE_TOKENIZER_PATH=your-hf-id/wheretogo-klue-roberta
SBERT_MODEL_PATH=BM-K/KoSimCSE-roberta

# private HF repo를 쓴다면 읽기 권한 토큰 필요 (공개 repo면 비워둬도 됨)
HF_TOKEN=

# Neon 등에서 발급받은 Postgres 연결 문자열
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# Groq API
LLM_API_KEY=gsk_xxx
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=llama-3.3-70b-versatile

DEFAULT_RADIUS_KM=3
TAG_THRESHOLD=0.5
ANALYSIS_TTL_MINUTES=30
USE_POSTGIS=false
MAX_INPUT_LENGTH=300
